# Keep the build context small and free of local or non-source state. Both Dockerfiles copy the
# whole context, so anything listed here never reaches a build layer or the cache key.
.git
.github
.claude
.worktrees
.idea
.vscode
.DS_Store
docs
charts
scripts
dist
**/*.md
Dockerfile*

# Test code and fixtures are not part of any build: nothing embeds them (there is no go:embed) and
# `go build` ignores _test.go files. The final stages copy only the built binary, so this does not change
# what ships (scripts/check-artifact-contents.sh asserts that); it keeps test code out of build layers
# and the build cache key.
**/*_test.go
**/testdata
internal/testca
